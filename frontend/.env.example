# Optional: dedicated Sepolia RPC endpoint for on-chain reads and wallet transactions.
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Optional: enables the full RainbowKit wallet catalog, including WalletConnect.
# Without this, an injected browser wallet is supported.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
